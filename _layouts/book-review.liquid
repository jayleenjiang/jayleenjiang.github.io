---
layout: default
---

<article class="book-review-page">
  <header class="book-review-header">
    <p class="book-review-kicker"><a href="{{ '/reading/' | relative_url }}">Bookshelf</a></p>
    <h1>{{ page.title }}</h1>
    {% if page.author or page.released %}
      <p class="book-review-byline">
        {% if page.author %}{{ page.author }}{% endif %}
        {% if page.author and page.released %}<span aria-hidden="true">&middot;</span>{% endif %}
        {% if page.released %}{{ page.released }}{% endif %}
      </p>
    {% endif %}
  </header>

  <div class="book-review-layout">
    <aside class="book-review-aside">
      {% if page.cover %}
        <img src="{{ page.cover | relative_url }}" alt="Cover of {{ page.title }}">
      {% elsif page.olid %}
        <img src="https://covers.openlibrary.org/b/olid/{{ page.olid }}-L.jpg?default=false" alt="Cover of {{ page.title }}">
      {% elsif page.isbn %}
        <img src="https://covers.openlibrary.org/b/isbn/{{ page.isbn }}-L.jpg?default=false" alt="Cover of {{ page.title }}">
      {% endif %}

      <dl class="book-review-facts">
        {% if page.finished %}
          <div>
            <dt>Read</dt>
            <dd>{{ page.finished | date: '%B %-d, %Y' }}</dd>
          </div>
        {% endif %}
        {% if page.stars %}
          <div>
            <dt>Rating</dt>
            <dd class="book-review-stars" aria-label="{{ page.stars }} out of 5 stars">
              {% assign full_stars = page.stars | floor %}
              {% assign empty_stars = 5 | minus: full_stars %}
              {% for i in (1..full_stars) -%}<i class="fa-solid fa-star" aria-hidden="true"></i>{%- endfor -%}
              {% for i in (1..empty_stars) -%}<i class="fa-regular fa-star" aria-hidden="true"></i>{%- endfor %}
            </dd>
          </div>
        {% endif %}
        {% if page.douban_url %}
          <div>
            <dt>Source</dt>
            <dd>
              <a href="{{ page.douban_url }}" target="_blank" rel="noopener noreferrer">
                View on Douban <i class="fa-solid fa-arrow-up-right-from-square fa-xs" aria-hidden="true"></i>
              </a>
            </dd>
          </div>
        {% endif %}
      </dl>
    </aside>

    <div class="book-review-content">
      <h2>{% if page.has_review %}My note{% else %}Reading record{% endif %}</h2>
      {{ content }}
      {% if page.publication %}
        <details class="book-review-edition">
          <summary>Edition details</summary>
          <p>{{ page.publication }}</p>
        </details>
      {% endif %}
    </div>
  </div>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</article>

<style>
  .book-review-page {
    margin: 0 auto;
    max-width: 60rem;
    padding: 2rem 0 4rem;
  }

  .book-review-header {
    border-bottom: 1px solid var(--global-divider-color);
    margin-bottom: 2rem;
    padding-bottom: 1.4rem;
  }

  .book-review-kicker {
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 0.7rem;
    text-transform: uppercase;
  }

  .book-review-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: 0;
    line-height: 1.15;
    margin-bottom: 0.65rem;
  }

  .book-review-byline {
    color: var(--global-text-color-light);
    margin: 0;
  }

  .book-review-byline span {
    margin: 0 0.4rem;
  }

  .book-review-layout {
    align-items: start;
    display: grid;
    gap: 2.5rem;
    grid-template-columns: minmax(170px, 230px) minmax(0, 1fr);
  }

  .book-review-aside > img {
    aspect-ratio: 2 / 3;
    border: 1px solid var(--global-divider-color);
    border-radius: 4px;
    display: block;
    object-fit: cover;
    width: 100%;
  }

  .book-review-facts {
    border-top: 1px solid var(--global-divider-color);
    margin-top: 1.25rem;
  }

  .book-review-facts > div {
    border-bottom: 1px solid var(--global-divider-color);
    display: grid;
    gap: 0.5rem;
    grid-template-columns: 3.5rem 1fr;
    padding: 0.65rem 0;
  }

  .book-review-facts dt,
  .book-review-facts dd {
    font-size: 0.8rem;
    margin: 0;
  }

  .book-review-facts dt {
    color: var(--global-text-color-light);
    font-weight: 500;
  }

  .book-review-stars {
    color: var(--global-theme-color);
    white-space: nowrap;
  }

  .book-review-stars i + i {
    margin-left: 0.12rem;
  }

  .book-review-content {
    font-size: 1rem;
    line-height: 1.75;
    min-width: 0;
  }

  .book-review-content h2 {
    font-size: 1.15rem;
    letter-spacing: 0;
    margin-bottom: 1rem;
  }

  .book-review-edition {
    border-top: 1px solid var(--global-divider-color);
    color: var(--global-text-color-light);
    font-size: 0.8rem;
    margin-top: 2rem;
    padding-top: 0.9rem;
  }

  .book-review-edition summary {
    cursor: pointer;
    font-weight: 600;
  }

  .book-review-edition p {
    margin: 0.6rem 0 0;
  }

  @media (max-width: 700px) {
    .book-review-layout {
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    .book-review-aside {
      max-width: 210px;
    }
  }
</style>
